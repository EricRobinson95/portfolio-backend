# Copy this file to .env for local development. Do not commit .env.
# Use real values only in your local .env or your AWS deployment secret store.
DATABASE_URL=postgresql+psycopg2://portfolio_user:replace-me@localhost:5432/portfolio_db
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ENVIRONMENT=development
PROJECT_NAME=Portfolio Backend API
API_VERSION=1.0.0
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me

# Leave blank in local development: FastAPI serves app/static at /static.
# In AWS production, use the CloudFront domain below and disable local static files.
CLOUDFRONT_DOMAIN=
S3_BUCKET=
AWS_REGION=us-east-2
SERVE_LOCAL_STATIC_FILES=true

# Enable only after verifying ALB append mode and backend port access from ALB only.
# Use the actual ALB subnet CIDRs, comma-separated; leave empty locally.
SECURITY_TRUSTED_PROXY_CIDRS=

# Enable local console tracing.
TRACING_ENABLED=false
TRACING_EXPORTER=console
# Production deployment selects otlp and enables tracing after collector setup.
TRACING_OTLP_ENDPOINT=http://portfolio-otel:4318/v1/traces
# Admin login requests are always traced; /health is excluded.
TRACING_SAMPLE_RATIO=0.1
